# Google AdSense publisher ID (get from https://adsense.google.com)
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_PUB_ID=

# Email results (https://resend.com) — the "email me the results" button only
# appears once both are set. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="CarCalc <results@your-domain.com>"

# Public site URL (set once a custom domain is connected)
NEXT_PUBLIC_SITE_URL=
